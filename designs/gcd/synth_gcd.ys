# ===========================================================
#  Yosys Synthesis Script — gcd → sky130_fd_sc_hd
#  Run via:  yosys synth_gcd.ys  (inside WSL)
#  Output:   results/gcd/1_synth.v  (gate-level netlist)
# ===========================================================

# ── Read the RTL source ──────────────────────────────────────
read_verilog /mnt/d/The\ Open\ Road/designs/gcd/gcd.v

# ── Set top module ───────────────────────────────────────────
hierarchy -check -top gcd

# ── Generic synthesis passes ─────────────────────────────────
proc
opt
fsm
opt
memory
opt

# ── Technology mapping to sky130 HD cells ────────────────────
# Update the path below if your PDK is installed elsewhere
techmap -map +/techmap.v
abc -liberty $env(PDK_ROOT)/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# ── Clean up ─────────────────────────────────────────────────
opt_clean -purge
setundef -zero
splitnets
opt_clean

# ── Write gate-level netlist ─────────────────────────────────
write_verilog -noattr -noexpr /mnt/d/The\ Open\ Road/results/gcd/1_synth.v

# Print stats
stat -liberty $env(PDK_ROOT)/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
